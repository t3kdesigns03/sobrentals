---
export interface Props {
  title: string;
  location: string;
  beds: number;
  baths: number;
  sleeps: number;
  description: string;
  rating: number | null;
  reviewCount: number | null;
  slug: string;
  heroImage: string;
}

const { title, location, beds, baths, sleeps, description, rating, reviewCount, slug, heroImage } = Astro.props;
---

<div class="property-card bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100">
  <div class="relative h-72 overflow-hidden">
    <img src={heroImage} alt={title} class="property-image w-full h-full object-cover transition-transform duration-500" />
    <div class="absolute top-4 left-4 bg-blue-600 text-white px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider cursor-pointer hover:bg-blue-700 transition-colors">
      CHECK AVAILABILITY
    </div>
  </div>
  <div class="p-6">
    <div class="flex justify-between items-start mb-2">
      <div>
        <h3 class="font-serif text-2xl font-bold text-gray-900 mb-1">{title}</h3>
        <p class="text-gray-500 flex items-center space-x-1">
          <i data-lucide="map-pin" class="h-4 w-4"></i>
          <span>{location}</span>
        </p>
      </div>
    </div>
    <div class="flex items-center space-x-4 my-4 py-4 border-y border-gray-100">
      <div class="flex items-center space-x-1 text-gray-600">
        <i data-lucide="bed-double" class="h-5 w-5"></i>
        <span class="font-medium">{beds} Beds</span>
      </div>
      <div class="flex items-center space-x-1 text-gray-600">
        <i data-lucide="bath" class="h-5 w-5"></i>
        <span class="font-medium">{baths} Baths</span>
      </div>
      <div class="flex items-center space-x-1 text-gray-600">
        <i data-lucide="users" class="h-5 w-5"></i>
        <span class="font-medium">Sleeps {sleeps}</span>
      </div>
    </div>
    <div class="mb-4">
      <h3 class="font-serif text-lg font-bold text-gray-900 mb-2">About this space</h3>
      <p class="text-gray-600 leading-relaxed text-sm line-clamp-3">{description}</p>
    </div>
    <div class="flex items-center justify-between">
      {rating != null && reviewCount != null ? (
        <div class="flex items-center space-x-1">
          <i data-lucide="star" class="h-5 w-5 text-gold-400 fill-current"></i>
          <span class="font-bold text-gray-900">{rating}</span>
          <span class="text-gray-500 text-sm">({reviewCount} reviews)</span>
        </div>
      ) : (
        <span></span>
      )}
      <a href={`/properties/${slug}`} class="bg-gray-900 hover:bg-gray-800 text-white px-6 py-3 rounded-full font-semibold transition-all inline-flex items-center space-x-2">
        <span>View Details</span>
        <i data-lucide="arrow-right" class="h-4 w-4"></i>
      </a>
    </div>
  </div>
</div>
