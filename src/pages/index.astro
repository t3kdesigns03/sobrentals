---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturedPropertyCard from '../components/FeaturedPropertyCard.astro';

// Homepage featured: exact 3 from live site with same titles/descriptions
const featured = [
  {
    title: 'Ledges 1037 Condo',
    location: 'Osage Beach · Main Channel Views',
    beds: 2,
    baths: 2,
    sleeps: 6,
    description: "SUNSET VIEW FOR MILES! Main Channel 2 Bed, 2 Bath-Sleeps 6- VERY CLEAN! Sheila's hand-managed luxury condo offering an unforgettable escape at Lake of the Ozarks. Fully remodeled with modern finishes and premium amenities for your comfort.",
    rating: 5.0,
    reviewCount: 28,
    slug: '2-bedroom-sleeps-6-unit-1037',
    heroImage: 'https://a0.muscache.com/im/pictures/miso/Hosting-29677039/original/48c6c2f5-7a14-4e1b-8bbf-11c2a674e28f.jpeg',
  },
  {
    title: 'Ledges 10210 Condo',
    location: 'Osage Beach · Main Channel Views',
    beds: 2,
    baths: 2,
    sleeps: 4,
    description: "Completely remodeled walk-in level (no steps) condo with spectacular main channel views at the 21 mile marker. King suite with private bath, modern electric fireplace, screened patio, and brand new everything — furniture, appliances, bedding. Overlooks the most popular area of the lake with constant boat/jet ski action.",
    rating: 5.0,
    reviewCount: 323,
    slug: '1-Bedroom-sleeps-4-unit-10210',
    heroImage: 'Properties/1%20Bedroom%20(Sleeps%204)%20-%20Unit%2010210/img013.jpeg',
  },
  {
    title: 'Ledges 1036',
    location: 'Osage Beach · Panoramic Lake Views',
    beds: 2,
    baths: 2,
    sleeps: 4,
    description: "Modern upscale condo with beautiful lake views. Open living and dining area. Master bedroom with king bed and master bath. 2nd bedroom with queen bed. 2nd full bath. Screened in deck with gorgeous main channel views. Outdoor pool and dock. Very close to the 19 mile marker by water and walking distance to restaurants and shops.",
    rating: null,
    reviewCount: null,
    slug: '2-bedroom-sleeps-4-unit-1036',
    heroImage: 'Properties/2%20Bedroom%20(Sleeps%204)%20-%20Unit%201036/img024.jpeg',
  },
];
---

<MainLayout>
  <Header />

  <!-- Hero Section -->
  <section id="home" class="relative min-h-screen flex items-center justify-center">
    <div class="absolute inset-0 z-0">
      <img src="/new_background_for_index.JPG" alt="Lake of the Ozarks" class="w-full h-full object-cover" />
      <div class="absolute inset-0 hero-gradient"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 text-center text-white pt-28 md:pt-44 lg:pt-52">
      <p class="text-accent-400 font-bold tracking-[0.3em] uppercase mb-6 text-lg leading-[30px]">
        LAKE OF THE OZARKS
      </p>
      <div class="flex items-center justify-center gap-5 md:gap-8 flex-wrap">
        <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-bold mb-0 leading-tight sob-outline">
          SOB Rentals
        </h1>
      </div>
      <p class="text-xl md:text-2xl mt-10 mb-12 text-gray-100 max-w-3xl leading-relaxed">
        Experience the finest Lake of the Ozarks properties with stunning views, private docks, and exceptional service.
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-20">
        <a href="/properties" class="btn-primary px-10 py-4 rounded-md font-semibold text-lg inline-flex items-center space-x-2">
          <span>EXPLORE PROPERTIES</span>
          <i data-lucide="arrow-right" class="h-5 w-5"></i>
        </a>
      </div>
      <div class="grid grid-cols-3 gap-6 md:gap-8 max-w-4xl border-t border-white/20 pt-12">
        <div class="text-center">
          <div class="text-4xl font-bold font-serif text-white mb-2">5.0★</div>
          <div class="text-sm text-gray-300 uppercase tracking-wider font-medium">GUEST RATING</div>
        </div>
        <div class="text-center text-accent-400">
          <div class="text-4xl font-bold font-serif mb-2">10/10</div>
          <div class="text-sm uppercase tracking-wider font-medium">Lake Life</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold font-serif text-white mb-2">100%</div>
          <div class="text-sm text-gray-300 uppercase tracking-wider font-medium">CUSTOMER SERVICE</div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce flex justify-center w-full pointer-events-none">
      <i data-lucide="chevron-down" class="h-8 w-8 text-accent-500 shrink-0"></i>
    </div>
  </section>

  <!-- Featured Properties -->
  <section id="properties" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-primary-600 font-semibold tracking-widest uppercase mb-2 text-sm">Featured</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-4">SOB Properties</h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Discover our handpicked selection of our Lake of the Ozarks vacation homes, each offering stunning views and world-class amenities.
        </p>
      </div>
      <div id="featured-properties-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featured.map((p) => (
          <FeaturedPropertyCard
            title={p.title}
            location={p.location}
            beds={p.beds}
            baths={p.baths}
            sleeps={p.sleeps}
            description={p.description}
            rating={p.rating}
            reviewCount={p.reviewCount}
            slug={p.slug}
            heroImage={p.heroImage}
          />
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/properties" class="btn-primary px-10 py-4 rounded-md font-semibold text-lg inline-flex items-center space-x-2">
          <span>View All Properties</span>
          <i data-lucide="arrow-right" class="h-5 w-5"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Amenities -->
  <section id="amenities" class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-primary-600 font-semibold tracking-widest uppercase mb-2 text-sm">Amenities</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-4">World-Class Features</h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Our properties offer premium amenities designed for ultimate comfort and enjoyment during your Lake of the Ozarks stay.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-2xl shadow-lg text-center border border-gray-100">
          <div class="feature-icon w-20 h-20 rounded-full mx-auto flex items-center justify-center mb-6">
            <i data-lucide="anchor" class="h-10 w-10 text-accent-500"></i>
          </div>
          <h3 class="font-serif text-2xl font-bold mb-4">Private Docks</h3>
          <p class="text-gray-600">Secure boat slips and easy lake access for all your water activities.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg text-center border border-gray-100">
          <div class="feature-icon w-20 h-20 rounded-full mx-auto flex items-center justify-center mb-6">
            <i data-lucide="waves" class="h-10 w-10 text-accent-500"></i>
          </div>
          <h3 class="font-serif text-2xl font-bold mb-4">Infinity Pools</h3>
          <p class="text-gray-600">Stunning pools with breathtaking views of the lake.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg text-center border border-gray-100">
          <div class="feature-icon w-20 h-20 rounded-full mx-auto flex items-center justify-center mb-6">
            <i data-lucide="chef-hat" class="h-10 w-10 text-accent-500"></i>
          </div>
          <h3 class="font-serif text-2xl font-bold mb-4">Gourmet Kitchens</h3>
          <p class="text-gray-600">Fully equipped with professional-grade appliances.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg text-center border border-gray-100">
          <div class="feature-icon w-20 h-20 rounded-full mx-auto flex items-center justify-center mb-6">
            <i data-lucide="wifi" class="h-10 w-10 text-accent-500"></i>
          </div>
          <h3 class="font-serif text-2xl font-bold mb-4">High-Speed WiFi</h3>
          <p class="text-gray-600">Stay connected with reliable internet throughout.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg text-center border border-gray-100">
          <div class="feature-icon w-20 h-20 rounded-full mx-auto flex items-center justify-center mb-6">
            <i data-lucide="tv" class="h-10 w-10 text-accent-500"></i>
          </div>
          <h3 class="font-serif text-2xl font-bold mb-4">Entertainment Systems</h3>
          <p class="text-gray-600">Smart TVs and premium sound systems.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg text-center border border-gray-100">
          <div class="feature-icon w-20 h-20 rounded-full mx-auto flex items-center justify-center mb-6">
            <i data-lucide="concierge-bell" class="h-10 w-10 text-accent-500"></i>
          </div>
          <h3 class="font-serif text-2xl font-bold mb-4">Concierge Service</h3>
          <p class="text-gray-600">24/7 assistance for all your needs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-primary-600 font-semibold tracking-widest uppercase mb-2 text-sm">About SOB Rentals</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Your Premier Lake of the Ozarks Experience
          </h2>
          <p class="text-gray-600 text-lg mb-6 leading-relaxed">
            SOB Rentals is dedicated to providing exceptional luxury vacation experiences at Lake of the Ozarks. With our carefully curated collection of 65 premium properties, we offer everything from intimate waterfront condos to sprawling lakeside estates.
          </p>
          <p class="text-gray-600 text-lg mb-8 leading-relaxed">
            Each property is meticulously maintained and equipped with top-tier amenities to ensure your stay is nothing short of perfect. Our team provides personalized service to make your vacation unforgettable.
          </p>
          <a href="/properties" class="btn-primary px-8 py-4 rounded-md font-semibold inline-flex items-center space-x-2">
            <span>Discover Properties</span>
            <i data-lucide="arrow-right" class="h-5 w-5"></i>
          </a>
        </div>
        <div class="relative">
          <img src="https://images.unsplash.com/photo-1505691938895-1758d7feb511?w=800&q=80" alt="Lake of the Ozarks Property" class="rounded-2xl shadow-2xl w-full h-[500px] object-cover" />
          <div class="absolute -bottom-8 -left-8 bg-white p-6 rounded-xl shadow-xl border border-gray-100 max-w-sm">
            <div class="flex items-center space-x-2 mb-2">
              <i data-lucide="star" class="h-5 w-5 text-gold-400 fill-current"></i>
              <span class="font-bold text-gray-900">5.0/5</span>
            </div>
            <p class="text-gray-600 italic">"Best vacation rental experience we've had!"</p>
          </div>
        </div>
      </div>
      <div class="mt-16 text-center">
        <img src="/jeffsheilaowner.png" alt="Owners Jeff and Sheila Becherer" class="mx-auto rounded-full w-48 h-48 object-cover shadow-lg mb-4" />
        <p class="font-serif text-2xl font-bold text-gray-900 mb-2">Meet the Owners</p>
        <p class="text-xl text-gray-700 mb-2">Jeff and Sheila Becherer</p>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Proudly managing premier vacation properties at Lake of the Ozarks, ensuring every detail is perfect for your unforgettable getaway.
        </p>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-primary-600 font-semibold tracking-widest uppercase mb-2 text-sm">Testimonials</p>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-4">What Our Guests Say</h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Hear from our satisfied guests about their unforgettable stays at our Lake of the Ozarks properties.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-100">
          <div class="flex text-gold-400 mb-4">
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
          </div>
          <p class="text-gray-600 mb-6 italic">"The Ledges condo exceeded all expectations. Waking up to those main channel views every morning was incredible. SOB Rentals made everything seamless from booking to checkout."</p>
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center">
              <i data-lucide="user" class="h-6 w-6 text-gray-400"></i>
            </div>
            <div>
              <div class="font-semibold text-gray-900">Sarah Mitchell</div>
              <div class="text-sm text-gray-500">Kansas City, MO</div>
            </div>
          </div>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-100">
          <div class="flex text-gold-400 mb-4">
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
          </div>
          <p class="text-gray-600 mb-6 italic">"Best family vacation we've had! The property was immaculate, the kitchen was fully stocked for cooking family dinners, and the kids loved the pool. We'll definitely be back!"</p>
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center">
              <i data-lucide="user" class="h-6 w-6 text-gray-400"></i>
            </div>
            <div>
              <div class="font-semibold text-gray-900">Michael Torres</div>
              <div class="text-sm text-gray-500">St. Louis, MO</div>
            </div>
          </div>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-100">
          <div class="flex text-gold-400 mb-4">
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
            <i data-lucide="star" class="h-5 w-5 fill-current"></i>
          </div>
          <p class="text-gray-600 mb-6 italic">"I've stayed at many Lake of the Ozarks rentals, and SOB Rentals properties are by far the most luxurious. Attention to detail is unmatched. The private dock was perfect for our boat."</p>
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center">
              <i data-lucide="user" class="h-6 w-6 text-gray-400"></i>
            </div>
            <div>
              <div class="font-semibold text-gray-900">Jennifer Adams</div>
              <div class="text-sm text-gray-500">Chicago, IL</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <p class="text-primary-600 font-semibold tracking-widest uppercase mb-2 text-sm">Contact Us</p>
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Plan Your Perfect Lake Getaway
          </h2>
          <p class="text-gray-600 text-lg mb-8">
            Ready to book your luxury Lake of the Ozarks vacation? Have questions about a specific property? Our team is here to help you plan the perfect escape.
          </p>
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="bg-primary-100 p-3 rounded-lg">
                <i data-lucide="mail" class="h-6 w-6 text-primary-600"></i>
              </div>
              <div>
                <div class="font-semibold text-gray-900">Email Us</div>
                <a href="mailto:sobrentals@yahoo.com" class="text-gray-600 hover:text-primary-600 transition-colors">sobrentals@yahoo.com</a>
              </div>
            </div>
            <div class="flex items-start space-x-4">
              <div class="bg-primary-100 p-3 rounded-lg">
                <i data-lucide="phone" class="h-6 w-6 text-primary-600"></i>
              </div>
              <div>
                <div class="font-semibold text-gray-900">Call Us</div>
                <a href="tel:+16183638065" class="text-gray-600 hover:text-primary-600 transition-colors">(618) 363-8065</a>
              </div>
            </div>
            <div class="flex items-start space-x-4">
              <div class="bg-primary-100 p-3 rounded-lg">
                <i data-lucide="clock" class="h-6 w-6 text-primary-600"></i>
              </div>
              <div>
                <div class="font-semibold text-gray-900">Office Hours</div>
                <div class="text-gray-600">Mon-Sat: 7:00 AM - 7:00 PM<br />Sunday: 7:00 AM - 5:00 PM</div>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-200">
          <h3 class="font-serif text-2xl font-bold text-gray-900 mb-6">Send Us a Message</h3>
          <form class="space-y-6" action="mailto:sobrentals@yahoo.com?subject=SOB%20Rentals%20Website%20Inquiry" method="POST" enctype="text/plain">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
                <input name="First Name" type="text" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all" placeholder="John" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
                <input name="Last Name" type="text" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all" placeholder="Doe" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
              <input name="Email" type="email" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all" placeholder="john@example.com" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Phone</label>
              <input name="Phone" type="tel" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all" placeholder="(555) 123-4567" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Interested Property</label>
              <select name="Interested Property" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all">
                <option>Select a property...</option>
                <option>Ledges 1037 Condo</option>
                <option>Ledges 10210 Condo</option>
                <option>Sunset View for Miles</option>
                <option>Any Available Property</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Message</label>
              <textarea name="Message" rows="4" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition-all" placeholder="Tell us about your ideal vacation dates and any special requests..."></textarea>
            </div>
            <button type="submit" class="w-full bg-gray-900 hover:bg-gray-800 text-white font-bold py-4 rounded-lg transition-all flex items-center justify-center space-x-2">
              <span>Send Message</span>
              <i data-lucide="send" class="h-5 w-5"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>
